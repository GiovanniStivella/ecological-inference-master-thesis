data <- readRDS(here("Data", "texas_with_covariates.rds"))
set.seed(123)
#install.packages("here")
library(here)
library(dplyr)
library(seine)
library(xtable)
data <- readRDS(here("Data", "texas_with_covariates.rds"))
View(data)
library(tidyverse)
library(tidycensus)
# Texas precinct-level covariates built from block-group ACS data.
# The core idea is to distribute each block-group estimate across VTDs
# using the population share of the blocks that belong to each VTD.
texas <- read.table(
"https://raw.githubusercontent.com/alarm-redist/census-2020/main/census-vest-2020/tx_2020_vtd.csv",
header = TRUE,
sep = ",",
dec = "."
)
View(texas)
block_codes <- read.table(
"BlockAssign_ST48_TX_VTD.txt",
header = TRUE,
sep = "|",
colClasses = "character"
)
elec_2020 <- data %>%
mutate(
pres_total = pre_20_rep_tru + pre_20_dem_bid
)
elec_2020 <- elec_2020 %>%
mutate(
no_college = rowSums(across(B15003_002:B15003_020)),
college = rowSums(across(B15003_021:B15003_025))
)
elec_2020 <- elec_2020 %>%
mutate(
other_ethnicity = rowSums(across(vap_aian:vap_two))
)
elec_2020 <- ei_proportions(elec_2020, pre_20_rep_tru:pre_20_dem_bid, .total = pres_total)
elec_2020 <- ei_proportions(elec_2020, c(vap_hisp:vap_black, other_ethnicity), .total = vap)
elec_2020 <- ei_proportions(elec_2020, no_college:college, .total = B15003_001)
#elec_2020 <- ei_proportions(elec_2020, B15003_002:B15003_025, .total = B15003_001)
#elec_2020 <- ei_proportions(elec_2020, B16004_001:B16004_067, .total = B16004_001)
elec_2020 <- ei_proportions(elec_2020, B23025_004:B23025_007, .total = B23025_001)
elec_2020_prerefined <- elec_2020%>%filter(pres_total>10 & vap>10 & vap>pres_total)
jpeg(filename = here("Paper/Images", "vap_vs_pres_total_texas.jpg"))
plot(elec_2020_prerefined$vap, elec_2020_prerefined$pres_total)
dev.off()
jpeg(filename = "../Paper/Images/vap_vs_pres_total_texas.jpg")
plot(elec_2020_prerefined$vap, elec_2020_prerefined$pres_total)
dev.off()
jpeg(filename = here("Paper/Images", "vap_vs_pres_total_texas.jpg"))
plot(elec_2020_prerefined$vap, elec_2020_prerefined$pres_total)
dev.off()
jpeg(
filename = here("Paper/Images", "vap_vs_pres_total_texas.jpg"),
width = 2400,
height = 1800,
units = "px",
res = 300,
quality = 100,
pointsize = 14
)
plot(
elec_2020_prerefined$vap,
elec_2020_prerefined$pres_total,
pch = 16,
cex = 0.7,
col = grDevices::adjustcolor("black", alpha.f = 0.45),
xlab = "Voting age population",
ylab = "Presidential votes"
)
dev.off()
jpeg(
filename = here("Paper/Images", "vap_vs_pres_total_texas.jpg"),
