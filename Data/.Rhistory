lapply(function(df) {
prova %>%
filter(GEOID %in% df$block_group) %>%
group_by(variable) %>%
summarise(easy_estimate = sum(estimate, na.rm = TRUE)) %>%
mutate(VTDST20GEOID = unique(df$VTDST20GEOID))
}) %>%
bind_rows()
auto_tedious2 <- differences_weighted %>%
split(.$VTDST20GEOID)%>%
lapply(function(df) {
prova %>%
filter(GEOID %in% df$block_group) %>%
group_by(variable) %>%
summarise(tedious_estimate = sum(estimate*(df$pop/df$group_pop), na.rm = TRUE)) %>%
mutate(VTDST20GEOID = unique(df$VTDST20GEOID))
}) %>%
bind_rows()
auto_tedious <- differences_weighted %>%
split(.$VTDST20GEOID)%>%
lapply(function(df) {
prova %>%
filter(GEOID %in% df$block_group) %>%
group_by(variable) %>%
mutate(tedious_estimate = sum(estimate*(df$pop/df$group_pop)), VTDST20GEOID = unique(df$VTDST20GEOID))
}) %>%
bind_rows()
View(auto_easy)
View(auto_easy2)
View(auto_tedious)
View(auto_tedious2)
auto_tedious <- differences_weighted %>%
split(.$VTDST20GEOID)%>%
lapply(function(df) {
prova %>%
filter(GEOID %in% df$block_group) %>%
group_by(variable) %>%
summarise(tedious_estimate = sum(estimate*(df$pop/df$group_pop), na.rm = TRUE)) %>%
mutate(VTDST20GEOID = unique(df$VTDST20GEOID))
}) %>%
bind_rows()
final <- auto_easy %>%
full_join(auto_tedious, by = c("variable"="variable", "VTDST20GEOID"="VTDST20GEOID"))%>%
mutate(total_estimate = coalesce(easy_estimate, 0) + coalesce(tedious_estimate, 0))%>%
select("VTDST20GEOID", "variable", "total_estimate")
View(final)
final_wide <- final %>%
pivot_wider(names_from = variable, values_from = total_estimate)
View(final_wide)
View(auto_easy)
