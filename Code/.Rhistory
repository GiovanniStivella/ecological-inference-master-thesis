elec_1968,
predictors = vap_white:vap_other,
outcome = pres_dem_hum:pres_ind_wal,
total = pres_total,
covariates = c(state, pop_city:pop_rural, farm:educ_coll,
inc_00_03k:inc_25_99k)
)
