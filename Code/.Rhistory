plot(elec_2020$college, elec_2020$vap_black)
plot(elec_2020$college, elec_2020$vap_hisp)
plot(elec_2020$college, elec_2020$other_ethnicity)
experiment <- ei_spec(
elec_2020,
predictors = c(vap_hisp:vap_black, other_ethnicity),
outcome = pre_20_rep_tru:pre_20_dem_bid,
total = pres_total,
